<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:css='false' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta content='width=device-width, initial-scale=1' name='viewport'/>
  <title><data:blog.pageTitle/></title>
  <b:skin><![CDATA[
    /* CSS Restro & Variables */
    :root {
      --bg-color: #a3d8f4;
      --card-bg: #6e6e6e;
      --border-color: #0088cc;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: linear-gradient(180deg, #87ceeb 0%, #b0e0e6 100%);
      font-family: Arial, sans-serif;
      min-height: 100vh;
      padding: 20px 0;
    }

    /* Outer Wrapper */
    .site-container {
      max-width: 1100px;
      margin: 0 auto;
      background: #ffffff;
      min-height: 90vh;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      position: relative;
    }

    /* Header Section */
    .site-header {
      padding: 15px 20px;
      border-bottom: 3px solid #87ceeb;
      position: relative;
    }

    .header-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
    }

    /* Logo Brand */
    .brand-logo {
      position: absolute;
      top: -10px;
      left: -10px;
      z-index: 10;
    }
    .brand-logo img {
      max-height: 70px;
    }

    /* Navigation Level 1 */
    .nav-primary {
      margin-left: 180px;
      display: flex;
      gap: 10px;
    }
    .nav-primary a {
      border: 1px solid var(--border-color);
      padding: 4px 12px;
      color: #0077b6;
      text-decoration: none;
      font-size: 20px;
      font-family: serif;
    }

    /* Social Icons Right */
    .social-links {
      display: flex;
      gap: 8px;
    }
    .social-links img {
      width: 24px;
      height: 24px;
    }

    /* Navigation Level 2 (Category Cards) */
    .nav-secondary {
      margin-left: 180px;
      display: flex;
      gap: 10px;
      align-items: center;
    }
    .nav-card {
      border: 1px solid var(--border-color);
      padding: 2px 8px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      color: #0077b6;
      font-size: 18px;
    }
    .nav-card img {
      max-height: 35px;
      object-fit: contain;
    }

    /* Main Grid Layout (4 Columns) */
    .main-content {
      padding: 40px 30px;
    }

    .post-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 25px;
    }

    .cover-card {
      background-color: var(--card-bg);
      aspect-ratio: 3 / 4;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      font-size: 20px;
      font-family: serif;
      text-decoration: none;
      border-radius: 2px;
      transition: transform 0.2s ease;
      overflow: hidden;
      position: relative;
    }

    .cover-card:hover {
      transform: translateY(-4px);
    }

    .cover-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Responsive adjustment */
    @media (max-width: 850px) {
      .post-grid { grid-template-columns: repeat(2, 1fr); }
      .brand-logo { position: static; }
      .nav-primary, .nav-secondary { margin-left: 0; }
    }
  ]]></b:skin>
</head>
<body>

  <div class='site-container'>
    <!-- Header -->
    <header class='site-header'>
      <div class='header-top'>
        <div class='brand-logo'>
          <a href='/'><img alt='Great Crossover' src='URL_LOGO_ANDA_HERE.png'/></a>
        </div>
        
        <nav class='nav-primary'>
          <a href='/'>Home</a>
          <a href='/p/about.html'>About</a>
        </nav>

        <div class='social-links'>
          <a href='#'><img alt='Reddit' src='https://www.redditstatic.com/shreddit/assets/favicon/192x192.png'/></a>
          <a href='#'><img alt='YouTube' src='https://www.youtube.com/s/desktop/f5d12325/img/favicon_144x144.png'/></a>
        </div>
      </div>

      <div class='nav-secondary'>
        <a class='nav-card' href='#'><img alt='Show' src='URL_TOMBOL_1.png'/></a>
        <a class='nav-card' href='#'><img alt='Twila' src='URL_TOMBOL_2.png'/></a>
        <a class='nav-card' href='#'><img alt='Phil &amp; Jacky' src='URL_TOMBOL_3.png'/></a>
        <a class='nav-card' href='#'>Special</a>
      </div>
    </header>

    <!-- Post Grid Section -->
    <main class='main-content'>
      <b:section id='main' showaddelement='yes'>
        <b:widget id='Blog1' locked='true' type='Blog'>
          <b:includable id='main'>
            <div class='post-grid'>
              <b:loop values='data:posts' var='post'>
                <a class='cover-card' expr:href='data:post.url'>
                  <b:if cond='data:post.firstImageUrl'>
                    <img expr:src='data:post.firstImageUrl'/>
                  <b:else/>
                    <span>Cover art</span>
                  </b:if>
                </a>
              </b:loop>
            </div>
          </b:includable>
        </b:widget>
      </b:section>
    </main>
  </div>

</body>
</html>
